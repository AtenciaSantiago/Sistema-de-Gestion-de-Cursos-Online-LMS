<mxfile host="app.diagrams.net" agent="Campus Digital - Entregable 3" version="24.7.17"><diagram id="d1" name="Diagrama de componentes UML"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Diagrama de componentes UML · Campus Digital (MVP)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1100" height="30" as="geometry"/></mxCell><mxCell id="n2" value="Estructura interna del contenedor «API REST» del modelo C4 (nivel 3) con notación UML: componentes, interfaces proporcionadas y requeridas, puertos y dependencias. Cada componente es una agrupación real del código." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="47" width="1100" height="40" as="geometry"/></mxCell><mxCell id="web" value="«component»&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;Angular 20 · TypeScript · Angular Material · se ejecuta en el navegador · interfaz de los tres roles (Administrador, Instructor, Estudiante) · requiere las interfaces REST de la API (JSON/HTTP con token JWT)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="50" y="85" width="1380" height="62" as="geometry"/></mxCell><mxCell id="n3" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="web"><mxGe