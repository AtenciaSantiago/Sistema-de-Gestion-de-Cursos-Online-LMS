<mxfile host="app.diagrams.net" agent="Campus Digital - Entregable 3" version="24.7.17"><diagram id="d1" name="Máquina de estados - Inscripcion"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Máquina de estados UML · Inscripción (clase Inscripcion)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Ciclo de vida de la inscripción de un estudiante en un curso. Sintaxis de cada transición: evento [guarda] / efecto. Los eventos son las operaciones reales del backend (src/services)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1200" height="40" as="geometry"/></mxCell><mxCell id="ini" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="16" y="258" width="24" height="24" as="geometry"/></mxCell><mxCell id="cho_o" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="66" y="252" width="36" height="36" as="geometry"/></mxCell><mxCell id="pend" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PENDIENTE&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid&quot;&gt;do / esperar el pago aprobado;&lt;br&gt;sin acceso al contenido (RN-01)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=13;strokeWidth=1.5;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="255" y="227" width="225" height="86" as="geometry"/></mxCell><mxCell id="cho_p" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="598" y="252" width="36" height="36" as="geometry"/></mxCell><mxCell id="act" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ACTIVA&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid&quot;&gt;do / permitir contenido y evaluaciones (RF-09)&lt;br&gt;marcar_completada() / registrar ProgresoLeccion&lt;br&gt;presentar() / registrar IntentoEvaluacion y Calificacion&lt;br&gt;evaluar_cierre() [faltan lecciones o evaluaciones] / sin cambio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=13;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="760" y="205" width="425" height="130" as="geometry"/></mxCell><mxCell id="cho_c" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1322" y="252" width="36" height="36" as="geometry"/></mxCell><mxCell id="apro" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;APROBADA&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid&quot;&gt;entry / emitir Certificado (RN-04)&lt;br&gt;do / contenido en solo lectura;&lt;br&gt;certificado descargable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=13;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1225" y="75" width="230" height="100" as="geometry"/></mxCell><mxCell id="repro" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;REPROBADA&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid&quot;&gt;do / contenido en solo lectura;&lt;br&gt;sin certificado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=13;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1225" y="385" width="230" height="82" as="geometry"/></mxCell><mxCell id="fin" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1480" y="256" width="28" height="28" as="geometry"/></mxCell><mxCell id="canc" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CANCELADA&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid&quot;&gt;do / sin acceso al contenido&lt;br&gt;(RF-09)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=13;strokeWidth=1.5;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="255" y="475" width="225" height="84" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ini" target="cho_o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="[por pago:&lt;br&gt;pagar_curso()]&lt;br&gt;/ crear Inscripcion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cho_o" target="pend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[por el administrador: matricular_manual()] / crear Inscripcion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.3;entryY=0;" edge="1" parent="1" source="cho_o" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="84" y="110"/><mxPoint x="887" y="110"/></Array></mxGeometry></mxCell><mxCell id="e6" value="pagar_curso()&lt;br&gt;/ procesar_pago()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pend" target="cho_p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[pago APROBADO]&lt;br&gt;/ registrar Pago" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cho_p" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[pago RECHAZADO] / registrar Pago" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="cho_p" target="pend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="616" y="355"/><mxPoint x="435" y="355"/></Array></mxGeometry></mxCell><mxCell id="e9" value="matricular_manual() [curso PUBLICADO y estudiante activo]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.1;entryY=0;" edge="1" parent="1" source="pend" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="367" y="165"/><mxPoint x="802" y="165"/></Array></mxGeometry></mxCell><mxCell id="e10" value="cancelar()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="pend" target="canc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="cancelar()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="act" target="canc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="802" y="500"/></Array></mxGeometry></mxCell><mxCell id="e12" value="matricular_manual() [curso PUBLICADO y estudiante activo]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0.42;entryY=1;" edge="1" parent="1" source="canc" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="938" y="538"/></Array></mxGeometry></mxCell><mxCell id="e13" value="pagar_curso() [pago APROBADO] / registrar Pago" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.72;entryY=1;" edge="1" parent="1" source="canc" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="367" y="590"/><mxPoint x="1066" y="590"/></Array></mxGeometry></mxCell><mxCell id="e14" value="evaluar_cierre()&lt;br&gt;[sin pendientes]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act" target="cho_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="[promedio ≥ 3,5]&lt;br&gt;/ notificar(EventoCierre)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cho_c" target="apro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="[promedio &amp;lt; 3,5]&lt;br&gt;/ notificar(EventoCierre)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cho_c" target="repro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="apro" target="fin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1494" y="125"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="repro" target="fin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1494" y="426"/></Array></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Trazabilidad&lt;/b&gt;&lt;br&gt;• Clase &lt;b&gt;Inscripcion&lt;/b&gt;, atributo &lt;b&gt;estado_inscripcion: EstadoInscripcion&lt;/b&gt; (src/entities/inscripcion.py).&lt;br&gt;• «sin pendientes» = todas las lecciones completadas y todas las evaluaciones aprobadas.&lt;br&gt;• pagar_curso(): src/services/checkout.py · HU-09 · RF-08, RF-11 · RN-01.&lt;br&gt;• matricular_manual() y cancelar(): src/services/inscripcion.py · RF-10 (solo Administrador).&lt;br&gt;• marcar_completada(): src/services/aula.py · HU-12 · RF-09, RF-14.&lt;br&gt;• presentar(): src/services/presentacion_evaluacion.py · HU-15 · RF-13.&lt;br&gt;• evaluar_cierre(): src/services/cierre.py · HU-16 · RF-15, RF-16, RF-18 · RN-04 (patrón Observer)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="500" height="190" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Transiciones que el sistema rechaza (no cambian el estado)&lt;/b&gt;&lt;br&gt;• cancelar() en APROBADA, REPROBADA o CANCELADA: «Solo se puede cancelar una inscripción PENDIENTE o ACTIVA».&lt;br&gt;• pagar_curso() en ACTIVA: «Ya te encuentras matriculado activamente en este curso».&lt;br&gt;• pagar_curso() en APROBADA o REPROBADA: «Ya finalizaste este curso; no se puede volver a comprar».&lt;br&gt;• matricular_manual() en ACTIVA, APROBADA o REPROBADA: «El estudiante ya tiene una inscripción en este curso».&lt;br&gt;• El valor FINALIZADA de la enumeración viene del Entregable 1; el MVP no lo asigna en ninguna transición." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="640" width="500" height="190" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="640" width="450" height="190" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Notación UML (guía «Máquina de Estados UML»)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1072" y="646" width="430" height="20" as="geometry"/></mxCell><mxCell id="c23" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1078" y="678" width="16" height="16" as="geometry"/></mxCell><mxCell id="c24" value="Estado inicial" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1104" y="674" width="150" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1076" y="706" width="20" height="20" as="geometry"/></mxCell><mxCell id="c26" value="Estado final" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1104" y="706" width="150" height="20" as="geometry"/></mxCell><mxCell id="c27" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1074" y="738" width="24" height="24" as="geometry"/></mxCell><mxCell id="c28" value="Decisión (choice):&lt;br&gt;guardas excluyentes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1104" y="734" width="160" height="34" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;ESTADO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=13;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1280" y="676" width="90" height="30" as="geometry"/></mxCell><mxCell id="c30" value="Estado; adentro, entry / do y&lt;br&gt;transiciones internas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1378" y="672" width="130" height="50" as="geometry"/></mxCell><mxCell id="e31" value="evento [guarda] / efecto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="750" as="sourcePoint"/><mxPoint x="1495" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="Transición: qué ocurre, cuándo se permite, qué se ejecuta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1275" y="762" width="225" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>