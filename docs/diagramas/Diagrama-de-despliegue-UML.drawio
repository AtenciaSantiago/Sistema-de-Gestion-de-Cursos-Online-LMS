<mxfile host="app.diagrams.net" agent="Campus Digital - Entregable 3" version="24.7.17"><diagram id="d1" name="Diagrama de despliegue UML"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Diagrama de despliegue UML · Campus Digital (MVP)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1100" height="30" as="geometry"/></mxCell><mxCell id="n2" value="Dónde se ejecuta cada artefacto del MVP: nodos, entornos de ejecución, artefactos desplegados, rutas de comunicación con su protocolo y puerto, y la relación «manifest» con los componentes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="47" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n3" value="«device»&lt;br&gt;&lt;b&gt;Computador de la demostración&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Windows 10/11 · aquí corren el navegador, el servidor de desarrollo de la aplicación web y la API (MVP en ejecución local)&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#FAFAFA;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="985" height="540" as="geometry"/></mxCell><mxCell id="n4" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Chrome, Edge o Firefox&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="245" height="200" as="geometry"/></mxCell><mxCell id="n5" value="«artifact»&lt;br&gt;&lt;b&gt;Aplicación web cargada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;index.html · main.js · styles.css&lt;br&gt;(la descarga del servidor de desarrollo)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="66" y="300" width="212" height="76" as="geometry"/></mxCell><mxCell id="n6" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n5"><mxGeometry x="192" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n7" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Node.js + Angular CLI 20&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;servidor de desarrollo «ng serve» · puerto 4200&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="372" y="215" width="245" height="265" as="geometry"/></mxCell><mxCell id="n8" value="«artifact»&lt;br&gt;&lt;b&gt;environment.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;apiUrl = http://127.0.0.1:8000&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="388" y="302" width="212" height="54" as="geometry"/></mxCell><mxCell id="n9" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n8"><mxGeometry x="192" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n10" value="«artifact»&lt;br&gt;&lt;b&gt;web/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;proyecto Angular 20 (TypeScript, Angular Material) y su compilación&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="388" y="368" width="212" height="76" as="geometry"/></mxCell><mxCell id="n11" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n10"><mxGeometry x="192" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n12" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Python 3 + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;entorno virtual «venv» · servidor ASGI · puerto 8000&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="690" y="215" width="295" height="340" as="geometry"/></mxCell><mxCell id="n13" value="«artifact»&lt;br&gt;&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;arranca Uvicorn con «src.app:app»&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="708" y="302" width="256" height="50" as="geometry"/></mxCell><mxCell id="n14" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n13"><mxGeometry x="236" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n15" value="«artifact»&lt;br&gt;&lt;b&gt;.env&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;DATABASE_URL · SECRET_KEY · ALGORITHM&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="708" y="362" width="256" height="50" as="geometry"/></mxCell><mxCell id="n16" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n15"><mxGeometry x="236" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n17" value="«artifact»&lt;br&gt;&lt;b&gt;src/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;paquete de la API REST (FastAPI + SQLAlchemy): endpoints, services, patrones, entities&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="708" y="422" width="256" height="84" as="geometry"/></mxCell><mxCell id="n18" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n17"><mxGeometry x="236" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n19" value="«device»&lt;br&gt;&lt;b&gt;Neon (nube)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;servicio gestionado de base de datos&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#FAFAFA;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1165" y="150" width="280" height="280" as="geometry"/></mxCell><mxCell id="n20" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;motor de base de datos&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1182" y="225" width="244" height="180" as="geometry"/></mxCell><mxCell id="n21" value="«artifact»&lt;br&gt;&lt;b&gt;Esquema de Campus Digital&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#333333&quot;&gt;tablas creadas por migrardb.py&lt;br&gt;(modelos de src/entities)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;spacingRight=16;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1198" y="300" width="210" height="76" as="geometry"/></mxCell><mxCell id="n22" value="" style="shape=note;size=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n21"><mxGeometry x="190" y="5" width="13" height="16" as="geometry"/></mxCell><mxCell id="n23" value="«device»&lt;br&gt;&lt;b&gt;Proveedor de pagos externo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;&lt;b&gt;PROYECTADO: no forma parte del MVP.&lt;/b&gt;&lt;br&gt;Hoy lo simula la clase&lt;br&gt;ProveedorPagosSimulado&lt;br&gt;dentro de la API (patrón Adapter).&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#555555;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1165" y="462" width="280" height="160" as="geometry"/></mxCell><mxCell id="e24" value="HTTP&lt;br&gt;(4200)" style="html=1;endArrow=none;strokeWidth=1.5;rounded=0;fontFamily=Helvetica;fontSize=11.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="283" y="330" as="sourcePoint"/><mxPoint x="372" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="HTTP · JSON con token JWT (8000)" style="html=1;endArrow=none;strokeWidth=1.5;rounded=0;fontFamily=Helvetica;fontSize=11.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="215" as="sourcePoint"/><mxPoint x="835" y="215" as="targetPoint"/><Array as="points"><mxPoint x="170" y="186"/><mxPoint x="835" y="186"/></Array></mxGeometry></mxCell><mxCell id="e26" value="" style="html=1;endArrow=none;strokeWidth=1.5;rounded=0;fontFamily=Helvetica;fontSize=11.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="973" y="330" as="sourcePoint"/><mxPoint x="1182" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="PostgreSQL/TCP&lt;br&gt;cifrado SSL (5432)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1022" y="292" width="136" height="34" as="geometry"/></mxCell><mxCell id="e28" value="" style="html=1;endArrow=none;strokeWidth=1.5;rounded=0;fontFamily=Helvetica;fontSize=11.5;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="973" y="530" as="sourcePoint"/><mxPoint x="1165" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n29" value="HTTPS · JSON (443)&lt;br&gt;proyectado" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fillColor=#FFFFFF;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1022" y="492" width="136" height="34" as="geometry"/></mxCell><mxCell id="n30" value="«component»&lt;br&gt;&lt;b&gt;Aplicación web&lt;/b&gt;" style="html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="409" y="720" width="170" height="52" as="geometry"/></mxCell><mxCell id="n31" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="n30"><mxGeometry x="146" y="5" width="18" height="16" as="geometry"/></mxCell><mxCell id="n32" value="«component»&lt;br&gt;&lt;b&gt;API REST de Campus Digital&lt;/b&gt;" style="html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="720" width="212" height="52" as="geometry"/></mxCell><mxCell id="n33" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="n32"><mxGeometry x="188" y="5" width="18" height="16" as="geometry"/></mxCell><mxCell id="e34" value="«manifest»" style="html=1;dashed=1;endArrow=open;endSize=9;strokeWidth=1.2;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" x="0.55"><mxPoint x="494" y="444" as="sourcePoint"/><mxPoint x="494" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="«manifest»" style="html=1;dashed=1;endArrow=open;endSize=9;strokeWidth=1.2;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" x="0.45"><mxPoint x="836" y="506" as="sourcePoint"/><mxPoint x="836" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n36" value="Componentes del diagrama de componentes que cada artefacto implementa. La «Base de datos» de ese diagrama es el esquema desplegado en Neon." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="409" y="782" width="640" height="34" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Especificación de despliegue (MVP)&lt;/b&gt;&lt;br&gt;• Arranque: 1-preparar-base-de-datos.bat y 2-iniciar-campus-digital.bat.&lt;br&gt;• API: «python main.py» → Uvicorn, host 0.0.0.0, puerto 8000, recarga automática.&lt;br&gt;• Web: «npm start» → ng serve, puerto 4200.&lt;br&gt;• CORS de la API: solo http://localhost:4200 y http://127.0.0.1:4200.&lt;br&gt;• Base de datos: conexión con sslmode=require; DATABASE_URL en .env.&lt;br&gt;• Sesiones: token JWT firmado con SECRET_KEY; vence a las 2 horas.&lt;br&gt;• En producción la web y la API irían por HTTPS (RNF-03)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="360" height="200" as="geometry"/></mxCell><mxCell id="n38" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="345" height="240" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Notación UML (guía «Diagrama de despliegue»)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="655" width="330" height="18" as="geometry"/></mxCell><mxCell id="n40" value="" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#FAFAFA;strokeColor=#000000;size=8;" vertex="1" parent="1"><mxGeometry x="1114" y="680" width="54" height="34" as="geometry"/></mxCell><mxCell id="n41" value="Nodo «device»: dispositivo o servicio donde corre el software" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1180" y="680" width="255" height="34" as="geometry"/></mxCell><mxCell id="n42" value="" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;flipH=1;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;strokeWidth=1.4;fillColor=#DAE8FC;strokeColor=#6C8EBF;size=8;" vertex="1" parent="1"><mxGeometry x="1114" y="724" width="54" height="34" as="geometry"/></mxCell><mxCell id="n43" value="Entorno de ejecución «executionEnvironment»: software que hospeda artefactos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1180" y="722" width="255" height="34" as="geometry"/></mxCell><mxCell id="n44" value="" style="html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1114" y="768" width="54" height="28" as="geometry"/></mxCell><mxCell id="n45" value="" style="shape=note;size=4;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="n44"><mxGeometry x="38" y="5" width="10" height="13" as="geometry"/></mxCell><mxCell id="n46" value="Artefacto «artifact» dentro de su nodo: está desplegado ahí («deploy»)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1180" y="766" width="255" height="34" as="geometry"/></mxCell><mxCell id="e47" value="" style="html=1;endArrow=none;strokeWidth=1.5;rounded=0;fontFamily=Helvetica;fontSize=11.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1114" y="816" as="sourcePoint"/><mxPoint x="1168" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n48" value="Ruta de comunicación: protocolo (puerto)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1180" y="807" width="255" height="18" as="geometry"/></mxCell><mxCell id="e49" value="" style="html=1;dashed=1;endArrow=open;endSize=9;strokeWidth=1.2;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1114" y="842" as="sourcePoint"/><mxPoint x="1168" y="842" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n50" value="«manifest»: el artefacto implementa el componente" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1180" y="833" width="255" height="18" as="geometry"/></mxCell><mxCell id="n51" value="" style="rounded=0;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1114" y="858" width="54" height="22" as="geometry"/></mxCell><mxCell id="n52" value="Línea punteada gris: elemento proyectado" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1180" y="860" width="255" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>